APP_NAME=Remnaum
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8080
APP_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_API_TOKEN=
LOG_LEVEL=INFO
# Standalone default; installer switches these automatically for a Panel host.
DEPLOY_MODE=standalone
COMPOSE_FILE=compose.yaml:compose.standalone.yaml
REMNAUM_LOCAL_PORT=18080
REMNAUM_PROXY_NETWORK=
PUBLIC_DOMAIN=webhook.example.com
WEBAPP_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql+asyncpg://remnaum:replace-with-a-random-password@postgres:5432/remnaum
REDIS_URL=redis://redis:6379/0
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=https://webhook.example.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_WEBHOOK=true
ADMIN_IDS=
REMNAWAVE_BASE_URL=
REMNAWAVE_API_TOKEN=
REMNAWAVE_WEBHOOK_SECRET=
REMNAWAVE_ACTIVE_INTERNAL_SQUADS=
PAYMENT_PROVIDER=multi
PAYMENT_WEBHOOK_SECRET=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_CURRENCY=RUB
YOOMONEY_RECEIVER=
YOOMONEY_NOTIFICATION_SECRET=
CRYPTOPAY_API_TOKEN=
CRYPTOPAY_API_BASE_URL=https://pay.crypt.bot/api
CRYPTOPAY_ACCEPTED_ASSETS=USDT,TON,BTC,ETH,TRX,USDC
TELEGRAM_TERMS_URL=
TELEGRAM_TERMS_VERSION=1
TARIFF_STARS_PRICE_PER_DAY=1
TARIFF_STARS_PRICE_PER_GB=1
TARIFF_STARS_PRICE_PER_DEVICE=10
PUBLIC_BASE_URL=https://app.example.com
WEBAPP_URL=https://app.example.com/app
SUPPORT_CONTACT=
REFERRAL_REWARD_DAYS=0
TARIFF_MIN_DAYS=7
TARIFF_MAX_DAYS=365
TARIFF_MIN_TRAFFIC_GB=10
TARIFF_MAX_TRAFFIC_GB=1000
TARIFF_MIN_DEVICES=1
TARIFF_MAX_DEVICES=10
TARIFF_PRICE_PER_DAY_MINOR=500
TARIFF_PRICE_PER_GB_MINOR=10
TARIFF_PRICE_PER_DEVICE_MINOR=1000
TARIFF_CURRENCY=RUB
