# Remnaum: только настройки запуска. Платежи, тарифы, бренд и рефералы — в БД.
APP_NAME=Remnaum
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8080
APP_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+asyncpg://remnaum:replace-me@postgres:5432/remnaum
POSTGRES_PASSWORD=replace-me
REDIS_URL=redis://redis:6379/0

# Установщик настраивает Docker и публичные домены.
DEPLOY_MODE=standalone
COMPOSE_FILE=compose.yaml:compose.standalone.yaml
REMNAUM_LOCAL_PORT=18080
REMNAUM_PROXY_NETWORK=
PUBLIC_DOMAIN=webhook.example.com
WEBAPP_DOMAIN=miniapp.example.com
ACME_EMAIL=admin@example.com
PUBLIC_BASE_URL=https://miniapp.example.com
WEBAPP_URL=https://miniapp.example.com/app

# Telegram: серверные секреты, доступ администратора и вебхуки.
TELEGRAM_BOT_TOKEN=
# 0 — выключено. Например, 3 — напомнить за три дня до окончания подписки.
RENEWAL_REMINDER_DAYS=0
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=https://webhook.example.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_WEBHOOK=true
ADMIN_IDS=

# Подключение к Remnawave (инфраструктурные ключи).
REMNAWAVE_BASE_URL=
REMNAWAVE_API_TOKEN=
REMNAWAVE_WEBHOOK_SECRET=
REMNAWAVE_ACTIVE_INTERNAL_SQUADS=
